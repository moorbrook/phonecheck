# voip.ms SIP credentials (create a limited sub-account for this)
SIP_USERNAME=your_subaccount
SIP_PASSWORD=your_password
SIP_SERVER=your_server.voip.ms
SIP_PORT=5060

# Target phone number to check (10 digits)
TARGET_PHONE=8005551234

# Expected greeting text. The SpeechAnalyzer transcript of the captured audio
# is compared against this with normalized token-level similarity (case and
# punctuation insensitive; tolerant of misheard/dropped words and truncation).
# Set it to what is typically heard within LISTEN_DURATION_SECS.
EXPECTED_GREETING="Thank you for calling Acme Corporation. If you know your party's extension"

# Similarity threshold in (0.0, 1.0]. 1.0 = every word must match, lower is
# more tolerant of ASR errors on 8 kHz telephone audio. Default: 0.75
# (tolerates roughly one misheard/dropped word in four).
# GREETING_MATCH_THRESHOLD=0.75

# How long to listen for audio after call connects (seconds, 1-300)
LISTEN_DURATION_SECS=10

# Minimum audio duration to consider valid (milliseconds)
# Audio shorter than this is treated as noise/glitches, not a real greeting
# Default: 500ms
MIN_AUDIO_DURATION_MS=500

# Pushover notifications (https://pushover.net)
# Create an app at https://pushover.net/apps/build to get API token
PUSHOVER_USER_KEY=your_user_key
PUSHOVER_API_TOKEN=your_api_token

# SpeechAnalyzer transcription helper binary (macOS 26+ Speech framework)
# Built automatically by `cargo build` (or manually: sh scripts/build_speech_helper.sh)
SPEECH_HELPER_PATH=./native/speech_helper

# Logging level
RUST_LOG=info

# STUN server for NAT traversal (required for NAT, see README)
STUN_SERVER=stun.l.google.com:19302

# Health check HTTP server port (optional, disabled if not set)
# Exposes /health (JSON status), /ready (503 if last check failed), /metrics (Prometheus)
# HEALTH_PORT=8080
